# Overwrite .gitignore with clean version
@"
# Android / Gradle
.gradle/
build/
*.iml
.idea/
local.properties
app/build/
captures/
.externalNativeBuild/
.cxx/

# Python Backend
backend/__pycache__/
backend/venv/
backend/env/
backend/.venv/
backend/*.pyc
backend/*.log
backend/logs/
*.log

# Logs
backend/logs/
*.log
logs/

# General
.DS_Store
Thumbs.db
"@ | Out-File -FilePath .gitignore -Encoding utf8 -Force

git add .gitignore
git commit -m "Final .gitignore + project cleanup" --allow-empty

# Force push the clean version
git push -u origin main --force