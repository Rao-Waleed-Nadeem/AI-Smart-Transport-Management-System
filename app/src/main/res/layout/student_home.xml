<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:id="@+id/main">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:background="#1976D2"
        android:elevation="10dp"
        android:paddingTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Left Bus Icon -->
        <ImageView
            android:id="@+id/busIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/baseline_directions_bus_24"
            app:tint="@android:color/white" />

        <!-- Title -->
        <TextView
            android:id="@+id/tv_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Student Dashboard"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Profile Icon (Right Side) -->
        <ImageView
            android:id="@+id/profileIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/baseline_person_24"
            app:tint="@android:color/white" />

    </LinearLayout>

    <!-- Main Scroll View for Cards -->
    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="0dp"


        android:scrollbars="none"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Seat Status Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_seat_status"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                app:strokeWidth="0dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                android:layout_marginHorizontal="16dp"
                app:cardBackgroundColor="#2196F3"
                app:cardElevation="6dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="20dp">

                    <!-- Icon positioned at top-right -->
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="top|end"
                        android:src="@drawable/baseline_event_seat_24"
                        android:contentDescription="Seat icon"
                        android:scaleType="fitCenter"
                        android:alpha="0.3"
                        app:tint="@android:color/white" />

                    <!-- Content at bottom -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="bottom">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SEAT STATUS"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/white"
                            android:alpha="0.8" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/seat_number"
                            android:text="A-23"
                            android:textSize="42sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/white"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bus B7"
                            android:textSize="12sp"
                            android:textColor="@android:color/white"
                            android:alpha="0.8"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Row for Attendance and Fee Due -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="177dp"
                android:baselineAligned="false"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Attendance Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_attendance"
                    android:layout_width="0dp"
                    app:strokeWidth="0dp"
                    android:layout_height="140dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#4CAF50"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="6dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="16dp">

                        <!-- Icon positioned at top-right -->
                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="top|end"
                            android:alpha="0.3"
                            android:contentDescription="Attendance icon"
                            android:scaleType="fitCenter"
                            android:src="@drawable/baseline_check_circle_24"
                            app:tint="@android:color/white" />

                        <!-- Content at bottom -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="bottom"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.8"
                                android:text="ATTENDANCE"
                                android:textColor="@android:color/white"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/attendance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="92%"
                                android:textColor="@android:color/white"
                                android:textSize="36sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/total_days"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:alpha="0.8"
                                android:text="-- days"
                                android:textColor="@android:color/white"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </FrameLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Fee Due Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_fee_due"
                    android:layout_width="0dp"
                    android:layout_height="140dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="16dp"
                    app:strokeWidth="0dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#FF9800"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="6dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="16dp">

                        <!-- Icon positioned at top-right -->
                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="top|end"
                            android:alpha="0.3"
                            android:contentDescription="Wallet icon"
                            android:scaleType="fitCenter"
                            android:src="@drawable/outline_account_balance_wallet_24"
                            app:tint="@android:color/white" />

                        <!-- Content at bottom -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="bottom"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.8"
                                android:text="FEE DUE"
                                android:textColor="@android:color/white"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/fees"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="$120"
                                android:textColor="@android:color/white"
                                android:textSize="36sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:alpha="0.8"
                                android:text="Fall 2026"
                                android:textColor="@android:color/white"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </FrameLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Route Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_route"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginBottom="16dp"
                app:strokeWidth="0dp"
                android:layout_marginHorizontal="16dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#9C27B0"
                app:cardElevation="6dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="20dp">

                    <!-- Icon positioned at top-right -->
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="top|end"
                        android:src="@drawable/baseline_location_on_24"
                        android:contentDescription="Location icon"
                        android:scaleType="fitCenter"
                        android:alpha="0.3"
                        app:tint="@android:color/white" />

                    <!-- Content at bottom -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="bottom">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ROUTE"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/white"
                            android:alpha="0.8" />

                        <TextView
                            android:id="@+id/route"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="R-04"
                            android:textSize="42sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/white"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Assigned Route"
                            android:textSize="12sp"
                            android:textColor="@android:color/white"
                            android:alpha="0.8"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Current Trip Status Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_trip_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_marginHorizontal="16dp"
                app:cardCornerRadius="16dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header with title and status badge -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Current Trip Status"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/black" />

                        <!-- Active Status Badge -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_trip_status_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:insetTop="8dp"
                            android:insetBottom="8dp"
                            style="@style/Widget.Material3.Button"
                            android:text="Active"
                            android:textSize="11sp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            app:backgroundTint="#4CAF50"
                            android:textColor="@android:color/white" />

                    </LinearLayout>

                    <!-- Trip details row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <!-- Bus details -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:padding="5dp"
                                android:layout_marginEnd="10dp"
                                android:background="@drawable/blue_full_rounded"
                                app:tint="@color/white"
                                android:src="@drawable/baseline_directions_bus_24"/>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Bus Num"
                                    android:textSize="11sp"
                                    android:textColor="#999999"
                                    android:alpha="0.7" />

                                <TextView
                                    android:id="@+id/bus_number"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="#7 - North Route"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="@android:color/black"
                                    android:layout_marginTop="2dp" />

                            </LinearLayout>
                        </LinearLayout>





                    </LinearLayout>

                    <!-- Progress info -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="6dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Trip Progress"
                                android:textSize="11sp"
                                android:textColor="#999999"
                                android:alpha="0.7" />

                            <TextView
                                android:id="@+id/tv_trip_progress_pct"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="11sp"
                                android:textColor="#1976D2"
                                android:textStyle="bold"
                                android:visibility="gone" />
                        </LinearLayout>

                        <!-- Progress Bar — hidden when no tracking data -->
                        <ProgressBar
                            android:id="@+id/trip_progress"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:progress="0"
                            android:max="100"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:progressDrawable="@drawable/progress_bar_style"
                            android:indeterminate="false"
                            android:visibility="gone" />

                        <!-- Status message — shown instead of bar when tracking unavailable -->
                        <TextView
                            android:id="@+id/tv_trip_progress_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Bus location not available"
                            android:textSize="12sp"
                            android:textColor="#999999"
                            android:drawablePadding="6dp"
                            android:gravity="center_vertical"
                            android:visibility="visible" />

                    </LinearLayout>

                    <!-- ── Track Live Bus button ── -->
                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="#EEEEEE"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_track_live_bus"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Track Live Bus"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="#1976D2"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/location"
                        app:iconSize="18dp"
                        app:iconTint="#ffffff"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Live Bus Location Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_live_location"
                android:layout_width="match_parent"
                app:strokeWidth="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                android:layout_marginHorizontal="16dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardElevation="6dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header row: title + "View Full Map" pill -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Route Preview"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/black" />

                        <TextView
                            android:id="@+id/tv_view_full_map"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="View Full Map →"
                            android:textSize="12sp"
                            android:textColor="#1976D2"
                            android:textStyle="bold"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:background="@drawable/blue_full_rounded"
                            android:backgroundTint="#E3F2FD" />
                    </LinearLayout>

                    <!-- Route meta info row -->
                    <LinearLayout
                        android:id="@+id/route_meta_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tv_route_name_map"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="13sp"
                            android:textColor="#444444"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_route_stops_map"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="#888888" />
                    </LinearLayout>

                    <!-- OSMDroid preview map — non-interactive (touch blocked by overlay) -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:clipToOutline="true">

                        <org.osmdroid.views.MapView
                            android:id="@+id/map_preview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <!-- Loading shimmer shown while route loads -->
                        <LinearLayout
                            android:id="@+id/map_loading"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#E3F2FD"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:visibility="visible">

                            <ProgressBar
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:indeterminateTint="#1976D2" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Loading route..."
                                android:textColor="#1976D2"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Transparent touch blocker — forces tap to go to card click
                             rather than scrolling the map inside the card -->
                        <View
                            android:id="@+id/map_touch_blocker"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clickable="true"
                            android:focusable="false" />

                    </FrameLayout>

                    <!-- Distance + time footer -->
                    <LinearLayout
                        android:id="@+id/route_footer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/baseline_location_on_24"
                            android:layout_marginEnd="4dp"
                            app:tint="#1976D2" />
                        <TextView
                            android:id="@+id/tv_route_distance"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="12sp"
                            android:textColor="#555555" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/outline_av_timer_24"
                            android:layout_marginEnd="4dp"
                            app:tint="#FF9800" />
                        <TextView
                            android:id="@+id/tv_route_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="#555555" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Your Supervisor Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_supervisor"
                android:layout_width="match_parent"
                app:strokeWidth="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                android:layout_marginHorizontal="16dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical"
                    android:baselineAligned="false">

                    <!-- Avatar -->
                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/avatar_background"
                        android:layout_marginEnd="12dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@drawable/baseline_person_24"
                            android:contentDescription="Supervisor avatar"
                            android:scaleType="fitCenter"
                            app:tint="@android:color/white" />

                    </FrameLayout>

                    <!-- Name + subtitle -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/supervisor_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Michael Johnson"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/black" />

                        <TextView
                            android:id="@+id/supervisor_bus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bus #7 Supervisor"
                            android:textSize="12sp"
                            android:textColor="#777777"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                    <!-- Action Pills (right) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_vertical">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/supervisor_phone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            app:icon="@drawable/outline_add_call_24"
                            app:iconTint="#F22E1F"
                            android:text="+1 234-567-8900"
                            android:textSize="12sp"
                            android:textColor="#333333"
                            app:cornerRadius="18dp"
                            app:strokeColor="#E0E0E0"
                            app:strokeWidth="1dp"
                            android:backgroundTint="#FFFFFF"
                            style="@style/Widget.MaterialComponents.Button" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_supervisor_route"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:layout_marginTop="5dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="Route R-04"
                            android:textSize="12sp"
                            android:textColor="@android:color/white"
                            app:cornerRadius="18dp"
                            android:backgroundTint="#1975d1"
                            style="@style/Widget.MaterialComponents.Button" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Monthly Summary Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_monthly_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:strokeWidth="0dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                android:layout_marginHorizontal="16dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Monthly Summary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_marginBottom="12dp" />

                    <!-- Summary Stats Grid -->
                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:rowCount="2"
                        android:layout_marginBottom="8dp">

                        <!-- Days Present -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_row="0"
                            android:layout_column="0"
                            android:layout_columnWeight="1"
                            android:layout_rowWeight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp"
                            android:layout_marginEnd="8dp"
                            android:layout_marginBottom="12dp"
                            android:background="#F5F5F5">

                            <TextView
                                android:id="@+id/present"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="23"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:textColor="#4CAF50" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Days Present"
                                android:textSize="11sp"
                                android:textColor="#999999"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                        <!-- Days Absent -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_row="0"
                            android:layout_column="1"
                            android:layout_columnWeight="1"
                            android:layout_rowWeight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp"
                            android:layout_marginStart="8dp"
                            android:layout_marginBottom="12dp"
                            android:background="#F5F5F5">

                            <TextView
                                android:id="@+id/absent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:textColor="#FF6B6B" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Days Absent"
                                android:textSize="11sp"
                                android:textColor="#999999"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                        <!-- Attendance Percentage -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_row="1"
                            android:layout_column="0"
                            android:layout_columnWeight="1"
                            android:layout_rowWeight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp"
                            android:layout_marginEnd="8dp"
                            android:background="#F5F5F5">

                            <TextView
                                android:id="@+id/attendance_percentage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="92%"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:textColor="#4CAF50" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Attendance"
                                android:textSize="11sp"
                                android:textColor="#999999"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                        <!-- Fee Paid -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_row="1"
                            android:layout_column="1"
                            android:layout_columnWeight="1"
                            android:layout_rowWeight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp"
                            android:layout_marginStart="8dp"
                            android:background="#F5F5F5">

                            <TextView
                                android:id="@+id/fee_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PAID"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:textColor="#FF9800" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fee Status"
                                android:textSize="11sp"
                                android:textColor="#999999"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                    </GridLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

    <!-- Bottom navigation placed directly in this layout (uses res/menu/bottom_nav_menu.xml) -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#ffff"
        app:menu="@menu/bottom_nav_menu"
        app:itemGravity="center"
        app:itemIconGravity="top"
        app:itemIconSize="24dp"
        app:itemIconTint="@color/bottom_nav_selector"
        app:itemTextColor="@color/bottom_nav_selector"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:itemActiveIndicatorStyle="@null"/>
</androidx.constraintlayout.widget.ConstraintLayout>